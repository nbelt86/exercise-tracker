<!DOCTYPE html>
<html>
  <head>
    <title>ExerciseTracker</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-900">
    <nav class="flex justify-between items-center px-6 py-4 bg-gradient-to-r from-gray-950 via-gray-900 to-gray-950 border-b border-red-900/40 shadow-lg">
      <%= link_to root_path, class: "text-2xl font-extrabold tracking-tight bg-gradient-to-r from-red-500 via-red-400 to-orange-400 bg-clip-text text-transparent hover:from-red-400 hover:to-orange-300 transition" do %>ExerciseTracker<% end %>
      <div class="flex gap-6">
        <%= link_to "Workouts", workouts_path, class: "text-gray-400 hover:text-white transition" %>
        <%= link_to "Exercises", exercises_path, class: "text-gray-400 hover:text-white transition" %>
        <%= link_to "New Workout", new_workout_path, class: "text-gray-400 hover:text-white transition" %>
      </div>
    </nav>
    <main class="container mx-auto mt-28 px-5 bg-gray-800 border border-gray-700 rounded-xl shadow-lg p-6">
      <%= yield %>
    </main>
  </body>
</html>
