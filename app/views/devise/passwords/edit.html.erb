<div class="flex flex-col gap-6 max-w-md mx-auto">
  <h1 class="text-2xl font-bold text-white">Change your password</h1>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_with model: resource, as: resource_name, url: password_path(resource_name), method: :put, class: "flex flex-col gap-4 bg-gray-900 border border-gray-700 rounded-lg p-6" do |f| %>
    <%= f.hidden_field :reset_password_token %>

    <div class="flex flex-col gap-1">
      <%= f.label :password, "New password", class: "font-bold text-white text-sm" %>
      <% if @minimum_password_length %>
        <span class="text-gray-500 text-xs"><%= @minimum_password_length %> characters minimum</span>
      <% end %>
      <%= f.password_field :password, required: true, autofocus: true, autocomplete: "new-password", class: "bg-gray-800 border border-gray-600 text-white rounded-md px-3 py-2 w-full" %>
    </div>

    <div class="flex flex-col gap-1">
      <%= f.label :password_confirmation, "Confirm your new password", class: "font-bold text-white text-sm" %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "bg-gray-800 border border-gray-600 text-white rounded-md px-3 py-2 w-full" %>
    </div>

    <%= f.submit "Change my password", class: "bg-red-600 hover:bg-red-700 text-white rounded-md px-3 py-2 font-medium transition cursor-pointer" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
