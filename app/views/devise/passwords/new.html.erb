<div class="flex flex-col gap-6 max-w-md mx-auto">
  <h1 class="text-2xl font-bold text-white">Forgot your password?</h1>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_with model: resource, as: resource_name, url: password_path(resource_name), method: :post, class: "flex flex-col gap-4 bg-gray-900 border border-gray-700 rounded-lg p-6" do |f| %>
    <div class="flex flex-col gap-1">
      <%= f.label :email, class: "font-bold text-white text-sm" %>
      <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "bg-gray-800 border border-gray-600 text-white rounded-md px-3 py-2 w-full" %>
    </div>

    <%= f.submit "Send me password reset instructions", class: "bg-red-600 hover:bg-red-700 text-white rounded-md px-3 py-2 font-medium transition cursor-pointer" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
