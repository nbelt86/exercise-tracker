<div class="flex flex-col gap-6 max-w-md mx-auto">
  <h1 class="text-2xl font-bold text-white">Log in</h1>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_with model: resource, as: resource_name, url: session_path(resource_name), class: "flex flex-col gap-4 bg-gray-900 border border-gray-700 rounded-lg p-6" do |f| %>
    <div class="flex flex-col gap-1">
      <%= f.label :email, class: "font-bold text-white text-sm" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "bg-gray-800 border border-gray-600 text-white rounded-md px-3 py-2 w-full" %>
    </div>

    <div class="flex flex-col gap-1">
      <%= f.label :password, class: "font-bold text-white text-sm" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "bg-gray-800 border border-gray-600 text-white rounded-md px-3 py-2 w-full" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "rounded" %>
        <%= f.label :remember_me, class: "text-gray-400 text-sm" %>
      </div>
    <% end %>

    <%= f.submit "Log in", class: "bg-red-600 hover:bg-red-700 text-white rounded-md px-3 py-2 font-medium transition cursor-pointer" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
