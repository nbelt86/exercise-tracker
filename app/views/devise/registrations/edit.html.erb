<div class="flex flex-col gap-6 max-w-md mx-auto">
  <h1 class="text-2xl font-bold text-white">Edit <%= resource_name.to_s.humanize %></h1>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), method: :put, class: "flex flex-col gap-4 bg-gray-900 border border-gray-700 rounded-lg p-6" do |f| %>
    <div class="flex flex-col gap-1">
      <%= f.label :email, class: "font-bold text-white text-sm" %>
      <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "bg-gray-800 border border-gray-600 text-white rounded-md px-3 py-2 w-full" %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p class="text-gray-400 text-sm">Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
    <% end %>

    <div class="flex flex-col gap-1">
      <%= f.label :password, class: "font-bold text-white text-sm" %>
      <span class="text-gray-500 text-xs">leave it blank if you don't want to change it</span>
      <%= f.password_field :password, autocomplete: "new-password", class: "bg-gray-800 border border-gray-600 text-white rounded-md px-3 py-2 w-full" %>
    </div>

    <div class="flex flex-col gap-1">
      <%= f.label :password_confirmation, class: "font-bold text-white text-sm" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "bg-gray-800 border border-gray-600 text-white rounded-md px-3 py-2 w-full" %>
    </div>

    <div class="flex flex-col gap-1">
      <%= f.label :current_password, class: "font-bold text-white text-sm" %>
      <span class="text-gray-500 text-xs">we need your current password to confirm your changes</span>
      <%= f.password_field :current_password, required: true, autocomplete: "current-password", class: "bg-gray-800 border border-gray-600 text-white rounded-md px-3 py-2 w-full" %>
    </div>

    <%= f.submit "Update", class: "bg-red-600 hover:bg-red-700 text-white rounded-md px-3 py-2 font-medium transition cursor-pointer" %>
  <% end %>

  <div class="bg-gray-900 border border-red-900/40 rounded-lg p-6 flex flex-col gap-3">
    <h2 class="text-lg font-bold text-white">Cancel my account</h2>
    <div class="text-gray-400 text-sm">
      Unhappy?
      <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete, class: "text-red-400 hover:text-red-300 bg-transparent border-none p-0 cursor-pointer underline" %>
    </div>
  </div>

  <%= link_to "Back", :back, class: "text-gray-400 hover:text-white text-sm transition" %>
</div>
