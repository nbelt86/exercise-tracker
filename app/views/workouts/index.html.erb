<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between gap-6 pb-2">
    <h1 class="text-2xl font-bold text-white">Workouts</h1>
    <%= link_to "+ New Workout", new_workout_path, class: "bg-red-600 text-white text-sm px-4 py-2 rounded-md hover:bg-red-700 font-medium transition" %>
  </div>

  <% if @workouts.any? %>
    <ul class="flex flex-col gap-3">
      <% @workouts.each do |workout| %>
        <li class="flex items-center gap-3">
          <%= link_to workout_path(workout), class: "flex-1 min-w-0 flex flex-col gap-2 bg-gray-900 border border-gray-700 rounded-lg p-4 hover:border-gray-600 hover:bg-gray-700 transition" do %>
            <span class="font-medium text-gray-100 hover:text-red-500 transition truncate"><%= workout.name %></span>
            <span class="text-xs text-gray-500 self-end"><%= workout.date&.strftime("%b %-d, %Y") %></span>
          <% end %>
          <%= button_to "Delete", workout_path(workout), method: :delete,
          data: { turbo_confirm: "Delete this workout? This cannot be undone." },
          class: "text-gray-500 hover:text-red-500 text-sm shrink-0 transition" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="flex flex-col items-center gap-3 text-center bg-gray-900 border border-dashed border-gray-700 rounded-lg py-12 px-4">
      <p class="text-gray-400">No workouts yet — log your first one to get started.</p>
      <%= link_to "+ New Workout", new_workout_path, class: "bg-red-600 text-white text-sm px-3 py-1.5 rounded-md hover:bg-red-700 font-medium transition" %>
    </div>
  <% end %>
</div>
