<div class="flex flex-col gap-4">

<h2 class="text-2xl font-bold text-gray-900"><%= @workout.name %></h2>
<p class="text-gray-700 border-t border-gray-100 pt-2"><%= @workout.date %></p>

<% @workout.exercise_entries.each do |entry| %>
  <div data-controller="toggle", class="bg-gray-50 border border-gray-200 rounded-lg p-4 shadow-sm">
    <strong class="text-lg font-bold text-gray-900"><%= entry.exercise.name%></strong>
    <%= button_to "Remove Exercise", workout_exercise_entry_path(@workout, entry), method: :delete,
    class:"text-red-600 hover:text-red-800 text-sm" %>

    <% entry.set_entries.each do |set| %>
      <p class="text-gray-700 border-t border-gray-100 pt-2">
        Set <%= set.set_number %>: <%= set.reps %> reps @ <%= set.weight %> lbs
        <%= button_to "Remove Set", workout_exercise_entry_set_entry_path(@workout, entry, set), method: :delete,
        class:"text-red-500 text-sm hover:text-red-900"%>
      </p>
    <% end %>

<button type="button" data-action="click->toggle#toggleVisibility"
class="text-gray-600 text-lg hover:text-gray-900">+ Add Set</button>
    <%= form_with model: [@workout, entry, entry.set_entries.new], data:{ toggle_target: "content" }, class: "hidden" do |f| %>

      <%= f.number_field :reps, placeholder: "Reps" %>
      <%= f.number_field :weight, placeholder: "Weight (lbs)" %>
      <%= f.submit "Add Set", class:"text-sm text-gray-600 hover:text-gray-900 font-medium" %>
    <% end %>
  </div>
<% end %>

<h3 class="text-gray-600 hover:text-gray-900 text-sm">Add Exercise</h3>
<%= form_with model: [@workout, @exercise_entry] do |f| %>
  <%= f.collection_select :exercise_id, @exercises, :id, :name, { prompt: "Select an exercise" } %>
  <%= f.submit "Add to Workout" %>
<% end %>

<%= link_to "Back to workouts", workouts_path %>
</div>
