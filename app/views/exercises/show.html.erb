<div class="flex flex-col gap-4 max-w-lg">
  <%= link_to "← Back to Exercises", exercises_path, class: "text-gray-500 hover:text-gray-700 text-sm w-fit" %>

  <div class="bg-gray-50 border border-gray-200 rounded-lg overflow-hidden">
    <% if @exercise.image_url.present? %>
      <img src="<%= @exercise.image_url %>" alt="<%= @exercise.name %>" class="w-full h-56 object-cover">
    <% end %>

    <div class="p-6 flex flex-col gap-3">
      <h1 class="text-2xl font-bold text-gray-900"><%= @exercise.name %></h1>

      <% if @exercise.muscles_target.present? %>
        <span class="inline-block w-fit bg-red-50 text-red-700 text-sm font-medium px-3 py-1 rounded-full">
          <%= @exercise.muscles_target %>
        </span>
      <% end %>

      <% if @exercise.description.present? %>
        <p class="text-gray-700 leading-relaxed border-t border-gray-200 pt-3"><%= @exercise.description %></p>
      <% end %>
    </div>
  </div>
</div>
